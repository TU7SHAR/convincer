# Required in production. Use a long random value and keep it private.
PRIVATE_PAGE_TOKEN=replace-with-a-long-random-token

# Neon pooled connection string from the Neon dashboard.
DATABASE_URL=postgresql://user:password@your-endpoint-pooler.neon.tech/database?sslmode=require

# The no-contact period started at this timestamp.
SEPARATION_DATE=2026-07-05T00:00:00+05:30

# Optional direct contact choices shown on the private response area.
# Include the country code and digits only.
WHATSAPP_NUMBER=
INSTAGRAM_URL=
CONTACT_EMAIL=

# Direct SMTP notifications for each new consented visit/section stamp.
# Port 465 normally uses SMTP_SECURE=true. Port 587 uses false with STARTTLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Falls back to CONTACT_EMAIL when left blank.
VISIT_NOTIFICATION_EMAIL=

# Required for /admin. Use a unique password and a random 32-byte secret.
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-session-secret
